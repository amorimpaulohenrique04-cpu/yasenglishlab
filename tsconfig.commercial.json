{
  "extends": "./tsconfig.json",
  "compilerOptions": { "incremental": false },
  "include": [
    "next-env.d.ts",
    "src/app/page.tsx",
    "src/app/(auth)/signup/**/*.tsx",
    "src/app/(auth)/signup/**/*.ts",
    "src/app/(commercial)/**/*.tsx",
    "src/app/(commercial)/**/*.ts",
    "src/app/test-billing/**/*.tsx",
    "src/modules/commercial/**/*.ts",
    "src/server/commercial/**/*.ts",
    "src/modules/auth/routing.ts",
    "tests/unit/auth-routing.test.ts",
    "tests/integration/auth-routing.test.ts",
    "tests/unit/commercial.test.ts",
    "tests/integration/commercial.test.ts",
    "tests/e2e/commercial.spec.ts"
  ],
  "exclude": ["node_modules", ".next", ".next-p18", ".next-p18-build"]
}
