{
  "name": "yasenglishlab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "npm run test:visual:storybook",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify.mjs",
    "verify:harness": "node scripts/verify-harness.mjs",
    "verify:ratchet": "node scripts/verify-ratchet.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:db": "node scripts/verify-db.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:agent": "npm run verify:core && npm run verify:harness && npm run verify:security && npm run eval:agent",
    "verify:full": "node scripts/verify-full.mjs",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:integration:db": "node scripts/run-sql-tests.mjs integration",
    "test:rls": "node scripts/run-sql-tests.mjs rls",
    "test:a11y": "playwright test -c playwright.a11y.config.ts",
    "test:visual:storybook": "playwright test -c playwright.visual.config.ts",
    "test:visual:golden": "playwright test -c playwright.golden.config.ts",
    "test:visual:update": "playwright test -c playwright.golden.config.ts --update-snapshots",
    "eval:agent": "node scripts/eval-agent.mjs",
    "verify:core": "node scripts/verify-core.mjs",
    "ci:policy": "node scripts/ci/check-repo-policy.mjs",
    "ci:secrets": "node scripts/ci/secret-scan.mjs",
    "ci:migrations": "node scripts/ci/check-migrations.mjs",
    "test:observability:live": "vitest run tests/integration/observability-live.test.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
