# Server canonical origin. Used to build password-recovery redirects.
APP_URL=http://localhost:3000

# Public Supabase values. Safe to expose only together with correct RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROTECTED_ASSETS_BUCKET=yas-protected-assets

# Non-secret observability context. CI/deploy should set the immutable release SHA.
APP_ENV=local
APP_VERSION=local
# Recorded video — server-only; configure separately for each environment.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY_BASE64=

# Billing — server-only. Explicit environment required; no automatic production fallback.
BILLING_PROVIDER=ASAAS
# FAKE is restricted to development/test, CANONICAL_E2E=1 and a loopback APP_URL.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
# Distinct Asaas webhook authToken, 32..255 non-whitespace characters; server-only.
ASAAS_WEBHOOK_TOKEN=

# Transactional notifications — server-only, verified sender domain required.
NOTIFICATION_PROVIDER=RESEND
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# FAKE requires explicit selection and NODE_ENV=test or development + loopback APP_URL.
