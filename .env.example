# Operational marker for local development only. Remote environments inject their own value.
YAS_ENVIRONMENT=local

# Server canonical origin. Used to build password-recovery redirects.
APP_URL=http://localhost:3000

# Public Supabase values. Safe to expose only together with correct RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROTECTED_ASSETS_BUCKET=yas-protected-assets
