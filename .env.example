# Server canonical origin. Used to build password-recovery redirects.
APP_URL=http://localhost:3000

# Public Supabase values. Safe to expose only together with correct RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROTECTED_ASSETS_BUCKET=yas-protected-assets

# Non-secret observability context. CI/deploy should set the immutable release SHA.
APP_ENV=local
APP_VERSION=local
# Recorded video — server-only; configure separately for each environment.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY_BASE64=
